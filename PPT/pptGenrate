// ── Icon helper ────────────────────────────────────────────────────────────
async function icon(IconComp, color="#FFFFFF", size=256) {
const { FaBrain, FaUpload, FaDownload, FaMagic, FaImage, FaCode, FaLayerGroup,
FaRocket, FaCheckCircle, FaServer, FaReact, FaCogs, FaDatabase,
FaBolt, FaEye, FaStar } = require("react-icons/fa");
const { MdBlurOff, MdHd, MdNoise } = require("react-icons/md");

const svg = ReactDOMServer.renderToStaticMarkup(
React.createElement(IconComp, { color, size: String(size) })
);
const buf = await sharp(Buffer.from(svg)).png().toBuffer();
return "image/png;base64," + buf.toString("base64");
}

async function makeIcon(name, color="#FFFFFF") {
const { FaBrain, FaUpload, FaDownload, FaMagic, FaImage, FaCode, FaLayerGroup,
FaRocket, FaCheckCircle, FaServer, FaReact, FaCogs, FaDatabase,
FaBolt, FaEye, FaStar, FaFilter, FaTools, FaFlask, FaNetworkWired } = require("react-icons/fa");
const { MdBlurOff } = require("react-icons/md");
const map = {
brain: FaBrain, upload: FaUpload, download: FaDownload, magic: FaMagic,
image: FaImage, code: FaCode, layers: FaLayerGroup, rocket: FaRocket,
check: FaCheckCircle, server: FaServer, react: FaReact, cogs: FaCogs,
database: FaDatabase, bolt: FaBolt, eye: FaEye, star: FaStar,
filter: FaFilter, tools: FaTools, flask: FaFlask, network: FaNetworkWired,
blur: MdBlurOff,
};
return await icon(map[name], color);
}

// ── Reusable slide helpers ────────────────────────────────────────────────
function addBg(slide, pres) {
slide.background = { color: C.bg };
}

// Glowing accent shape
function accent(slide, pres, x, y, w, h, col=C.purple) {
slide.addShape(pres.shapes.RECTANGLE, {
x, y, w, h, fill: { color: col }, line: { color: col, width: 0 }
});
}

// Card shape
function card(slide, pres, x, y, w, h, fill=C.bgCard) {
slide.addShape(pres.shapes.ROUNDED_RECTANGLE, {
x, y, w, h,
fill: { color: fill },
line: { color: C.purple, width: 1 },
rectRadius: 0.08,
shadow: { type: "outer", color: "000000", blur: 12, offset: 3, angle: 135, opacity: 0.4 }
});
}

// Section title strip
function sectionTitle(slide, pres, text, sub="") {
// Left accent bar
slide.addShape(pres.shapes.RECTANGLE, {
x: 0.4, y: 0.25, w: 0.07, h: 0.55, fill: { color: C.cyan }, line: { color: C.cyan, width: 0 }
});
slide.addText(text, {
x: 0.6, y: 0.18, w: 9, h: 0.5,
fontFace: "Arial Black", fontSize: 26, color: C.white, bold: true, margin: 0
});
if (sub) slide.addText(sub, {
x: 0.6, y: 0.7, w: 9, h: 0.28,
fontFace: "Calibri", fontSize: 13, color: C.muted, margin: 0
});
}

